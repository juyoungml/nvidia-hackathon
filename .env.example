# Copy to .env and fill in locally. .env is gitignored; never commit real keys.

# Required for live NVIDIA hosted NIM runs (poc/, evaluation/, scripts/check_nvidia.py).
# Create one at https://build.nvidia.com. Not needed for the static demo or unit tests.
NVIDIA_API_KEY=

# Optional: number of retries poc/live_investigation.py makes on transient
# HTTP 429/500/502/503 responses from the NVIDIA API (honours Retry-After,
# otherwise backs off 10s, 20s, ...). Defaults to 0 (no retry).
# Note: this is read from the process environment, not parsed from .env, e.g.
#   NVIDIA_HTTP_RETRIES=3 uv run python -m poc.live_investigation ...
# NVIDIA_HTTP_RETRIES=3
